# Copy to .env (or run `python scripts/setup_env.py`, which fills the change_me
# values with random secrets). .env is git-ignored. LOCAL DEVELOPMENT ONLY.

# --- PostgreSQL warehouse ---------------------------------------------------
POSTGRES_USER=sales_user
# Kept equal to the Phase-1 starter password so an existing volume keeps working.
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=sales_dw
POSTGRES_PORT=5434
# Used by code running on the host (outside Docker). Containers override it.
DATABASE_URL=postgresql://sales_user:local_dev_only@127.0.0.1:5434/sales_dw

# Read-only reporting account used by Metabase (created by `src.cli init`).
METABASE_DB_USER=metabase_reader
METABASE_DB_PASSWORD=change_me

# --- Metadata database for Airflow + Metabase application data --------------
META_DB_ADMIN_PASSWORD=change_me
AIRFLOW_DB_PASSWORD=change_me
METABASE_APP_DB_PASSWORD=change_me

# --- Data lake ------------------------------------------------------------------
# minio = local MinIO container (default). aws = Amazon S3 with the EC2 IAM role:
# generate with `python3 scripts/setup_env.py --aws ...` and start with
# compose.aws.yaml (see docs/DEPLOY_AWS.md).
LAKE_STORAGE=minio
S3_REGION=us-east-1
MINIO_ROOT_USER=lake_admin
MINIO_ROOT_PASSWORD=change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Host-side access (containers use http://minio:9000).
S3_ENDPOINT_URL=http://127.0.0.1:9000
LAKE_BRONZE_BUCKET=bronze
LAKE_SILVER_BUCKET=silver
LAKE_GOLD_BUCKET=gold
LAKE_VERSIONS_TO_KEEP=5

# --- Airflow ----------------------------------------------------------------------
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
# Must be a urlsafe base64 32-byte key; setup_env.py generates one.
AIRFLOW_FERNET_KEY=change_me
AIRFLOW_JWT_SECRET=change_me

# --- Metabase -----------------------------------------------------------------------
METABASE_PORT=3000
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=change_me

# --- Spark ---------------------------------------------------------------------------
# local[*] runs Spark inside the calling container. For the optional cluster:
# SPARK_MASTER=spark://spark-master:7077  (and start the spark-cluster profile)
SPARK_MASTER=local[*]
SPARK_SHUFFLE_PARTITIONS=8
SPARK_DRIVER_MEMORY=2g

# --- Pipeline behaviour -----------------------------------------------------------
SALES_DAILY_RECORDS=1000
SALES_GENERATOR_SEED=42
# Share of generated rows turned into data-quality test cases.
SALES_DIRTY_RATE=0.02
# Quality gate: fail the run if more than this share of rows is rejected.
MAX_REJECT_RATE=0.10
ALLOWED_CURRENCIES=INR
# Optional REST source, e.g. http://mock-api:8000/sales (leave empty to generate data)
SALES_API_URL=
# Optional: POST failure notifications (Slack/Teams/any webhook accepting JSON)
ALERT_WEBHOOK_URL=
LOG_LEVEL=INFO
